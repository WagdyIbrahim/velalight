  <!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VelaLight - Handmade Candles</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #fff8f0;
            margin: 0;
            text-align: center;
            color: #4b3621;
        }

        header {
            background: #c89b6d;
            color: white;
            padding: 25px;
        }

        .products {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
            padding: 30px;
        }

        .card {
            background: white;
            width: 250px;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 3px 10px #ddd;
        }

        .card img {
            width: 100%;
            border-radius: 10px;
        }

        button {
            background: #8b5e3c;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 20px;
            cursor: pointer;
        }

        a {
            color: white;
            text-decoration: none;
        }
    </style>
</head>

<body>

<header>
    <h1>VelaLight</h1>
    <p>شموع يدوية مصنوعة بإتقان وحب</p>
</header>

<section class="products">

    <div class="card">
        <img src="https://via.placeholder.com/250" alt="شمعة">
        <h2>شمعة فانيليا</h2>
        <p>رائحة هادئة ومميزة</p>
        <p>السعر: 100 جنيه</p>
        <button>اطلب الآن</button>
    </div>

    <div class="card">
        <img src="https://via.placeholder.com/250" alt="شمعة">
        <h2>شمعة ورد</h2>
        <p>تصميم يدوي أنيق</p>
        <p>السعر: 120 جنيه</p>
        <button>اطلب الآن</button>
    </div>

</section>

</body>
</html>
